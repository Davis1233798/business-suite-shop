FROM golang:1.26-bookworm AS build
WORKDIR /source
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/station-server .

FROM debian:bookworm-slim
ARG SUITE_RELEASE_SHA=dev
ENV SUITE_RELEASE_SHA=$SUITE_RELEASE_SHA
WORKDIR /srv/station
RUN useradd -r -u 10001 station && mkdir -p /srv/station/data && chown station:station /srv/station/data
COPY --from=build /out/station-server /srv/station/station-server
COPY web-dist/ /srv/station/web-dist/
ENV SUITE_WEB=/srv/station/web-dist SUITE_DB=/srv/station/data/stations.sqlite SUITE_ADDR=0.0.0.0:8095
USER station
EXPOSE 8095
CMD ["/srv/station/station-server"]
