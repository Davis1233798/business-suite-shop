# No secrets or payment credentials are required for the demonstration.
# Optional local preview settings; shell environment values are preserved.
CLOUDFLARE_CF_FETCH_ENABLED=false
WRANGLER_SEND_METRICS=false
# DB is a Cloudflare D1 binding, not an environment URL or file path.
# Declare DB in .openai/hosting.json and apply migrations from README.md.
# Optional local Go Shop pilot override (unset keeps the SQLite repository):
# SUITE_DATABASE_URL=postgres://shop_runtime:password@127.0.0.1:5432/shop
